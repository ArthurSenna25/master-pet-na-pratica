      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "policies": {},
      "checkConstraints": {
        "lead_status_ck": {
          "name": "lead_status_ck",
          "value": "\"lead\".\"status\" in ('novo','em_contato','convertido','nao_convertido')"
        },
        "lead_nome_ck": {
          "name": "lead_nome_ck",
          "value": "\"lead\".\"anonimizado_em\" is not null or (char_length(\"lead\".\"nome\") between 2 and 80 and \"lead\".\"nome\" ~ '^[[:alpha:]][[:alpha:] ''.-]*$' and \"lead\".\"nome\" ~ '[[:alpha:]].*[[:alpha:]]')"
        },
        "lead_whatsapp_ck": {
          "name": "lead_whatsapp_ck",
          "value": "\"lead\".\"anonimizado_em\" is not null or \"lead\".\"whatsapp\" ~ '^[0-9]{10,11}$'"
        },
        "lead_negocio_ck": {
          "name": "lead_negocio_ck",
          "value": "\"lead\".\"anonimizado_em\" is not null or (char_length(\"lead\".\"negocio\") between 2 and 80 and \"lead\".\"negocio\" ~ '[[:alpha:]]')"
        },
        "lead_cidade_uf_ck": {
          "name": "lead_cidade_uf_ck",
          "value": "char_length(\"lead\".\"cidade_uf\") <= 70 and \"lead\".\"cidade_uf\" ~ '^[[:alpha:]][[:alpha:] ''-]*/[A-Z]{2}$' and right(\"lead\".\"cidade_uf\", 2) in ('AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO')"
        },
        "lead_mensagem_ck": {
          "name": "lead_mensagem_ck",
          "value": "\"lead\".\"mensagem\" is null or char_length(\"lead\".\"mensagem\") <= 1000"
        },
        "lead_observacao_ck": {
          "name": "lead_observacao_ck",
          "value": "\"lead\".\"observacao\" is null or char_length(\"lead\".\"observacao\") <= 2000"
        },
        "lead_origem_ck": {
          "name": "lead_origem_ck",
          "value": "char_length(\"lead\".\"origem\") <= 300"
        }
      },
      "isRLSEnabled": false
    },
